# RateDeck bootstrap configuration
# Copy to .env during installation. Never commit real secrets.

TELEGRAM_BOT_TOKEN=
ADMIN_IDS=

# Runtime
RATEDECK_ENV=production
RATEDECK_LOG_LEVEL=INFO
RATEDECK_TIMEZONE=Asia/Tehran
RATEDECK_DATA_DIR=/opt/ratedeck/data
RATEDECK_DB_PATH=/opt/ratedeck/data/ratedeck.db

# Provider base URLs are overrideable for controlled diagnostics/tests.
# Production defaults should be defined in typed configuration and validated.
NOBITEX_BASE_URL=https://apiv2.nobitex.ir
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
EXCHANGERATE_OPEN_BASE_URL=https://open.er-api.com/v6
EXCHANGERATE_KEYED_BASE_URL=https://v6.exchangerate-api.com/v6

# Optional bootstrap API keys.
# Keys set through Telegram admin should be encrypted in application storage.
COINGECKO_API_KEY=
EXCHANGERATE_API_KEY=

# Master secret should normally be generated/stored by installer outside repo.
RATEDECK_SECRET_KEY_FILE=/etc/ratedeck/secret.key
